{
  "manifest_version": 3,
  "name": "Clean Print – Edit Page, Save Clean PDF",
  "short_name": "Clean Print",
  "description": "Remove ads, menus and clutter before printing. Freeze the page, delete what you don't need, save a clean PDF.",
  "version": "0.1.0",
  "author": "Alp Arslan",
  "homepage_url": "https://github.com/ArslanYigitAlp/clean-print",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clean Print: edit this page for printing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      }
    }
  }
}